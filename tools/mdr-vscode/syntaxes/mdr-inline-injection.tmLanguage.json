{
  "name": "MDR Inline Syntax",
  "scopeName": "mdr.inline.injection",
  "injectionSelector": "L:source.mdr -markup.fenced_code -markup.inline.raw -meta.embedded.inline.typst.math.mdr",
  "patterns": [
    {
      "name": "meta.inline.tag.mdr",
      "begin": "(:)([a-z][a-z0-9-]*)?((?:[.#][a-zA-Z_][\\w-]*)*)(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "entity.other.attribute-name.class.css"
        },
        "4": {
          "name": "entity.name.tag.html"
        }
      },
      "endCaptures": {
        "1": {
          "name": "entity.name.tag.html"
        }
      },
      "patterns": []
    },
    {
      "match": "(?<![\\\\`])(`)(?!`)([^`\\n]*)(?<!`)(`)(?!`)",
      "captures": {
        "1": {
          "name": "comment.line.mdr"
        },
        "2": {
          "name": "markup.inline.raw.string.markdown"
        },
        "3": {
          "name": "comment.line.mdr"
        }
      }
    },
    {
      "match": "(?<!\\\\)(\\[)([^\\]\\n]+)(\\])(\\()([^)\\s\\n]+)(\\))",
      "captures": {
        "1": {
          "name": "punctuation.definition.link.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.link.end.markdown"
        },
        "4": {
          "name": "punctuation.definition.link.begin.markdown"
        },
        "6": {
          "name": "punctuation.definition.link.end.markdown"
        }
      }
    },
    {
      "name": "meta.link.definition.mdr",
      "match": "(?<!\\\\)(\\[)([^\\]\\n]+)(\\])(?!\\()",
      "captures": {
        "1": {
          "name": "punctuation.definition.link.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.link.end.markdown"
        }
      }
    },
    {
      "name": "constant.character.escape.markdown",
      "match": "\\\\[\\\\`*{}\\[\\]()#+\\-.!_$:>/]"
    },
    {
      "match": "(?<![\\\\*])(\\*)([^*\\n]+?)(?<!\\\\)(\\*)(?!\\*)",
      "captures": {
        "1": {
          "name": "markup.bold.markdown"
        },
        "2": {
          "name": "markup.bold.markdown"
        },
        "3": {
          "name": "markup.bold.markdown"
        }
      }
    },
    {
      "name": "meta.embedded.inline.typst.math.mdr",
      "begin": "(?<![\\\\$])(\\$)(?!\\$)",
      "end": "(?<![\\\\$])(\\$)(?!\\$)",
      "beginCaptures": {
        "1": {
          "name": "string.other.math.delimiter.mdr"
        }
      },
      "endCaptures": {
        "1": {
          "name": "string.other.math.delimiter.mdr"
        }
      },
      "patterns": [
        {
          "include": "source.typst#math"
        }
      ]
    }
  ]
}
